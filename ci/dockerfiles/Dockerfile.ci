# syntax=docker/dockerfile:1.4
ARG base_image
FROM ${base_image}

USER root

ARG PIP_INDEX_URL_BASE=""

ENV DEBIAN_FRONTEND=noninteractive
# Install Python 3.12 via deadsnakes PPA
# TO DO: This RUN code should be removed when upgrading to Ubuntu >24.04 (python 3.12 is a default Ubuntu >24.04)
RUN apt-get update && apt-get install -y software-properties-common && \
    add-apt-repository ppa:deadsnakes/ppa && \
    apt-get update && apt-get install -y \
      python3.12 \
      python3.12-dev \
      python3.12-full \
      python3.12-venv && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 && \
    python3.12 -m ensurepip --upgrade

RUN apt-get -y update && apt-get -y install \
    rsync build-essential bash ca-certificates zip unzip curl gettext jq git wget tar xz-utils \
    openssl libxml2-utils gnupg lsb-release openssh-server openssh-client

RUN set -eux; \
    gover="$(curl -fsSL 'https://go.dev/VERSION?m=text' | head -n1 | tr -d '\r\n')"; \
    test -n "$gover"; \
    wget -q "https://go.dev/dl/${gover}.linux-amd64.tar.gz" -O /tmp/go.tgz; \
    tar -C /usr/local -xzf /tmp/go.tgz; \
    rm /tmp/go.tgz
ENV PATH="/usr/local/go/bin:${PATH}"

# Below: upstreams ship official release archives (zip/tar.xz + static binaries), not first-party install.sh.
# Syft uses Anchore's install.sh later in this file.
RUN wget "https://github.com/koalaman/shellcheck/releases/download/stable/shellcheck-stable.linux.x86_64.tar.xz" && \
    tar --xz -xvf shellcheck-stable.linux.x86_64.tar.xz && \
    cp shellcheck-stable/shellcheck /usr/bin/

RUN wget "https://dl.minio.io/server/minio/release/linux-amd64/minio" && \
    chmod +x minio && \
    mv minio /usr/bin/minio

RUN wget "https://dl.minio.io/client/mc/release/linux-amd64/mc" && \
    chmod +x mc && \
    mv mc /usr/bin/mc

RUN wget https://releases.hashicorp.com/terraform/1.0.11/terraform_1.0.11_linux_amd64.zip && \
    unzip terraform_1.0.11_linux_amd64.zip -d /usr/bin

# install BOSH
RUN wget "https://github.com/cloudfoundry/bosh-cli/releases/download/v6.2.1/bosh-cli-6.2.1-linux-amd64" -O bosh
RUN chmod +x ./bosh && \
    mv ./bosh /usr/bin/bosh

# install credhub
RUN wget "https://github.com/cloudfoundry-incubator/credhub-cli/releases/download/2.6.2/credhub-linux-2.6.2.tgz" -O credhub.tgz
RUN tar xzf credhub.tgz
RUN chmod +x ./credhub && \
    mv ./credhub /usr/bin/credhub

# install fly
RUN wget "https://tpe-concourse-rock.acc.broadcom.net/api/v1/cli?arch=amd64&platform=linux" -O fly
RUN chmod +x ./fly && \
    mv ./fly /usr/bin/fly

# install https://github.com/sclevine/yj
RUN wget "https://github.com/sclevine/yj/releases/download/v4.0.0/yj-linux" -O yj
RUN chmod +x ./yj && \
    mv ./yj /usr/bin/yj

# install om from Concourse github-release input (om-release); avoids api.github.com in the build
COPY om-release /tmp/om-release
RUN set -eux; \
    om="$(find /tmp/om-release -name 'om-linux-amd64-*' -type f | head -n1)"; \
    test -n "$om"; \
    cp "$om" /usr/bin/om && chmod +x /usr/bin/om; \
    rm -rf /tmp/om-release

# rspec
RUN apt-get -y install ruby ruby-dev && \
    echo "gem: --no-document" >> /etc/gemrc && \
    gem install rspec english bundler

# uaac
RUN gem install cf-uaac

# Black Duck Detect requires Java 17+ for current 9.x line
RUN apt-get -y update && apt-get -y install openjdk-17-jre-headless && \
    java -version

# Pin Detect launcher script + JAR for reproducible scans
ENV DETECT_VERSION=10.7.0
ENV DETECT_JAR_PATH=/opt/blackduck/detect/
ENV BLACKDUCK_SCAN_HOME=/opt/blackduck
RUN mkdir -p /opt/blackduck/detect && \
    curl -fsSL "https://detect.blackduck.com/detect10.sh" -o /usr/local/bin/detect.sh && \
    chmod +x /usr/local/bin/detect.sh && \
    curl -fsSL "https://repo.blackduck.com/bds-integrations-release/com/blackduck/integration/detect/${DETECT_VERSION}/detect-${DETECT_VERSION}.jar" \
      -o "${DETECT_JAR_PATH}"/detect-${DETECT_VERSION}.jar

# govc
#RUN go install github.com/vmware/govmomi/govc@latest

# govc binary
RUN wget https://github.com/vmware/govmomi/releases/latest/download/govc_Linux_x86_64.tar.gz && \
    tar xvfz govc_Linux_x86_64.tar.gz -C  /usr/local/bin govc

# gcloud — official Linux installer (Google documented path; matches Dockerfile.packages)
RUN curl https://sdk.cloud.google.com > /tmp/install-gcloud.sh && bash /tmp/install-gcloud.sh --disable-prompts && rm -f /tmp/install-gcloud.sh
ENV PATH="/root/google-cloud-sdk/bin:${PATH}"
RUN ln -s /root/google-cloud-sdk/bin/* /usr/local/bin/
RUN gcloud --version

# AWS CLI v2 — official bundle installer (same model as gcloud install.sh; not distro awscli metapackage)
# https://docs.aws.amazon.com/cli/latest/userguide/getting-started-install.html
RUN set -eux; \
    curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip; \
    unzip -q /tmp/awscliv2.zip -d /tmp; \
    /tmp/aws/install -i /usr/local/aws-cli -b /usr/local/bin; \
    rm -rf /tmp/awscliv2.zip /tmp/aws

# Azure CLI — Microsoft-maintained script for Debian/Ubuntu (adds apt repo + installs azure-cli)
# https://learn.microsoft.com/en-us/cli/azure/install-azure-cli-linux?pivots=apt
RUN set -eux; \
    export DEBIAN_FRONTEND=noninteractive; \
    curl -sL https://aka.ms/InstallAzureCLIDeb | bash

# Fix GHSA-x744-4wpc-v9h2, GHSA-4c29-8rgm-jvjj, GHSA-4vrq-3vrq-g6gg: Upgrade docker to a secure version
# Match Dockerfile.packages: internal PyPI when creds + base are set (blocked public PyPI in some networks).
# OpenStack: pip install matches Dockerfile.packages; Azure comes from Microsoft's script above.
RUN --mount=type=secret,id=artifactory_user,dst=/run/secrets/artifactory_user \
    --mount=type=secret,id=artifactory_pass,dst=/run/secrets/artifactory_pass \
    if [ -s /run/secrets/artifactory_user ] && [ -s /run/secrets/artifactory_pass ] && [ -n "${PIP_INDEX_URL_BASE}" ]; then \
        export PIP_INDEX_URL="https://$(cat /run/secrets/artifactory_user):$(cat /run/secrets/artifactory_pass)@${PIP_INDEX_URL_BASE}"; \
        echo "pip: using internal index"; \
    else \
        echo "pip: using default public index"; \
    fi && \
    pip3 install python-openstackclient && \
    pip3 install --upgrade \
        "wheel>=0.38.1" \
        "cryptography>=42.0.0" \
        "docker>=7.1.0" \
        "requests>=2.31.0" \
        "pytest>=8.0.0"
RUN az --version && aws --version && openstack --version


# Upgrade all packages
RUN apt-get upgrade -y

RUN git config --global user.name "platform-automation"
RUN git config --global user.email "platformautomation@groups.vmware.com"

# used by test
RUN go install github.com/onsi/ginkgo/ginkgo@latest

# use to cleanup IAASes
RUN wget -O /usr/bin/leftovers "https://github.com/genevieve/leftovers/releases/download/v0.70.0/leftovers-v0.70.0-linux-amd64"
RUN chmod +x /usr/bin/leftovers

# install syft for scanning images
RUN curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b /usr/local/bin

ENV CGO_ENABLED=0
