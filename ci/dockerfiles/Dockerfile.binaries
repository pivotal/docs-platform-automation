ARG base_image
FROM ${base_image}

# copy files directly from the inputs/resource of concourse
COPY bbr-cli/*linux* /usr/bin/bbr
COPY bosh-cli/bosh-cli-* /usr/bin/bosh
COPY isolation-segment-replicator/replicator-linux* /usr/bin/iso-replicator
COPY om-cli/om /usr/bin/om
COPY winfs-injector/winfs-injector-linux* /usr/bin/winfs-injector
COPY govc-cli/*Linux* /tmp
COPY credhub-cli/*linux* /tmp
# stembuild 2019 binary (cloudfoundry/bosh-windows-stemcell-builder): install as stembuild-2019
COPY stembuild-cli/stembuild-linux* /tmp/stembuild-2019
# stembuild 2022 binary (TNZ/bosh-windows-stemcell-builder tag 2022.0 on GHE): install as stembuild-2022
COPY stembuild-cli-2022/stembuild-linux* /tmp/stembuild-2022

RUN tar xvf /tmp/govc* && mv govc /usr/bin/govc
RUN tar xvf /tmp/credhub* && mv credhub /usr/bin/credhub
# stembuild binaries (not tarballs): install as stembuild-2019 and stembuild-2022
RUN chmod +x /tmp/stembuild-2019 /tmp/stembuild-2022 && mv /tmp/stembuild-2019 /usr/bin/stembuild-2019 && mv /tmp/stembuild-2022 /usr/bin/stembuild-2022
# build.sh uses STEMBUILD_BIN_DIR to find stembuild-2019 / stembuild-2022 (and future stembuild-2025) by windows_version

# Download LGPO (Local Group Policy Object Utility) from Microsoft
# LGPO is required by stembuild and must be in the same directory as stembuild binary
# According to documentation: https://bosh.io/docs/windows-stemcell-create/
# Microsoft Download Center: https://www.microsoft.com/en-us/download/details.aspx?id=55319
# Stembuild looks for LGPO.exe in the same directory as the stembuild binary
RUN mkdir -p /tmp/lgpo && \
    cp docs-platform-automation/windows-automation/LGPO.zip /tmp/lgpo/LGPO.zip  && \
    cd /tmp/lgpo && \
    unzip -q LGPO.zip && \
    # LGPO.zip contains LGPO.exe - copy it to /usr/bin/ alongside stembuild
    # Stembuild will use LGPO.exe during the construct process on the Windows VM
    cp LGPO.exe /usr/bin/LGPO.exe 2>/dev/null || \
    (find . -name "*.exe" -type f | head -1 | xargs -I {} cp {} /usr/bin/LGPO.exe) && \
    cd / && \
    rm -rf /tmp/lgpo && \
    # Verify LGPO.exe was copied successfully
    test -f /usr/bin/LGPO.exe || echo "WARNING: Failed to extract LGPO.exe"

# Make copied binaries executable
RUN chmod +x \
    /usr/bin/bbr \
    /usr/bin/bosh \
    /usr/bin/credhub \
    /usr/bin/govc \
    /usr/bin/iso-replicator \
    /usr/bin/om \
    /usr/bin/stembuild-2019 \
    /usr/bin/stembuild-2022 \
    /usr/bin/winfs-injector

# Install Packer
ENV CHECKPOINT_DISABLE=1
ENV PACKER_PLUGIN_PATH=/root/.packer.d/plugins
ENV PACKER_VERSION=1.16.0
RUN wget -q https://releases.hashicorp.com/packer/${PACKER_VERSION}/packer_${PACKER_VERSION}_linux_amd64.zip \
    && unzip -o packer_${PACKER_VERSION}_linux_amd64.zip \
    && chmod +x packer \
    && mv packer /usr/bin/packer \
    && rm -f packer_${PACKER_VERSION}_linux_amd64.zip

# Create Packer plugin directory and install vsphere plugin
RUN mkdir -p /root/.packer.d/plugins \
    && cd /root/.packer.d/plugins \
    && wget -q https://github.com/vmware/packer-plugin-vsphere/releases/download/v2.3.0/packer-plugin-vsphere_v2.3.0_x5.0_linux_amd64.zip \
    && unzip packer-plugin-vsphere_v2.3.0_x5.0_linux_amd64.zip \
    && chmod +x packer-plugin-vsphere_v2.3.0_x5.0_linux_amd64 \
    && rm -f packer-plugin-vsphere_v2.3.0_x5.0_linux_amd64.zip

# Verify Packer installation
RUN packer version

# Verify stembuild installation (build.sh selects stembuild-2019 / stembuild-2022 / stembuild-2025 by windows_version)
RUN stembuild-2019 version || echo "stembuild-2019 version check (may not support version flag)"
RUN stembuild-2022 version || echo "stembuild-2022 version check (may not support version flag)"

# Verify LGPO is present
RUN ls -la /usr/bin/LGPO.exe || echo "WARNING: LGPO.exe not found - stembuild construct may fail"
