>>>>>>> 754259ed (bump python dependencies to fix the CVEs)
RUN curl https://sdk.cloud.google.com > install.sh && bash install.sh --disable-prompts
RUN /root/google-cloud-sdk/bin/gcloud components update --quiet || true
ENV PATH /root/google-cloud-sdk/bin:$PATH
RUN ln -s /root/google-cloud-sdk/bin/* /usr/local/bin/
RUN gcloud --version

# azure - upgrade to latest to ensure security patches
RUN pip3 install --upgrade azure-cli
RUN az --version

# aws - upgrade to latest to ensure security patches
RUN pip3 install --upgrade awscli
RUN aws --version

# openstack - upgrade to latest to ensure security patches
RUN pip3 install --upgrade python-openstackclient
RUN openstack --version

# Final security update pass and cleanup
RUN apt-get update && apt-get upgrade -y
RUN apt-get autoremove -y build-essential python3-dev
RUN apt-get clean && rm -rf /var/lib/apt/lists/*