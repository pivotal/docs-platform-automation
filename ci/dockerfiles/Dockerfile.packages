ARG base_image

FROM ${base_image}

# Install necessary binary
USER root
RUN apt-get update && apt-get -y --no-install-recommends install \
    bash \
    build-essential \
    ca-certificates \
    curl \
    gettext \
    git \
    netcat-openbsd \
    python3 \
    python3-dev \
    python3-setuptools \
    python3-pip \
    rsync \
    ssh \
    unzip \
    zip \
    wget \
    sshpass \
    jq \
    libxml2-utils \
  && true
# netcat for `bosh ssh` -- the why is explained here: https://github.com/cloudfoundry/bosh-cli/issues/374

# gcloud
RUN curl https://sdk.cloud.google.com > install.sh && bash install.sh --disable-prompts
ENV PATH /root/google-cloud-sdk/bin:$PATH
RUN ln -s /root/google-cloud-sdk/bin/* /usr/local/bin/
RUN gcloud --version

# azure
RUN pip3 install azure-cli
RUN az --version

# aws
RUN pip3 install awscli
RUN aws --version

# openstack
RUN pip3 install python-openstackclient
RUN openstack --version

# Fix CVE-2022-40897 (GHSA-r9hx-vwmv-q579), CVE-2024-6345, and CVE-2025-47273
RUN pip3 install --upgrade setuptools>=78.1.1

# Fix CVE-2022-40898 (GHSA-qwmp-2cf2-g9g6): Upgrade wheel to a secure version (>=0.38.1)
RUN pip3 install --upgrade wheel>=0.38.1

# Fix CVE-2023-50782: Upgrade cryptography to a secure version (>=42.0.0)
# CVE-2023-50782: Bleichenbacher timing oracle attack in cryptography < 42.0.0
RUN pip3 install --upgrade cryptography>=42.0.0

# Upgrade all packages
RUN apt-get upgrade -y
RUN apt-get autoremove -y build-essential python3-dev