# syntax=docker/dockerfile:1.4
ARG base_image
FROM ${base_image}

ARG PIP_INDEX_URL_BASE=""

# remove azure, aws, Openstack cli, and pip
# pip-autoremove is incompatible with Python 3.12
# pip uninstall is sufficient here — all Python dirs are wiped below anyway.
RUN pip3 uninstall -y azure-cli awscli python-openstackclient pip

# remove gcloud CLI
RUN rm -Rf /usr/local/bin/gcloud
RUN rm -Rf /root/google-cloud-sdk

RUN rm -Rf /usr/lib/python*
RUN rm -Rf /usr/bin/python*
RUN rm -Rf /usr/local/lib/python*
RUN rm -Rf /usr/local/bin/python*
RUN rm -Rf /etc/python*
