  CONFIG_FILE: config.yml
  # - Required
  # - Filepath of the assign-kubernetes-distribution config YAML
  # - The path is relative to root of the `config` input

run:
  path: platform-automation-tasks/tasks/assign-kubernetes-distribution.sh

